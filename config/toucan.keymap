#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// Deutsche Layout-Übersetzungen importieren
#include "keys_de.h"

#define NOTED  0
#define QWERTZ 1
#define SYMB   2
#define NAVI   3
#define FUNC   4

/ {
    behaviors {
        // Home Row Mods Anpassung (HRM)
        hm: home_row_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Layer Tap für Daumen / Außenbahnen
        lt_b: layer_taps {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Globaler Daumen-Combo (ESC Daumen + TAB Daumen) -> Öffnet FUNC Layer
        combo_thumb_func {
            timeout-ms = <50>;
            key-positions = <37 38>; 
            bindings = <&mo FUNC>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        noted {
            display-name = "NOTED";
            bindings = <
                &kp TAB          &kp DE_Z      &kp DE_Y      &kp DE_U       &kp DE_A       &kp DE_Q      &kp DE_P &kp DE_B       &kp DE_M       &kp DE_L      &kp DE_F      &kp DE_J
                &lt_b SYMB LCTRL &hm LGUI DE_C &hm LALT DE_S &hm LSHFT DE_I &hm LCTRL DE_E &kp DE_O      &kp DE_D &hm RCTRL DE_T &hm RSHFT DE_N &hm LALT DE_R &hm RGUI DE_H &lt_b SYMB DE_SZ
                &kp LSHFT        &kp DE_V      &kp DE_X      &kp DE_UE      &kp DE_AE      &kp DE_OE     &kp DE_N &kp DE_M       &kp COMMA      &kp DOT       &kp DE_K      &kp ESC
                                                  &kp LGUI &kp RET &mo 1   &mo 2 &kp SPACE &kp BSPC
            >;
        };

        symb {
            display-name = "SYM";
            bindings = <
                &kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
                &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
                &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        navi {
            display-name = "NAV";
            bindings = <
                &kp TAB     &kp N1          &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
                &bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
                &kp LSHFT   &studio_unlock  &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                                &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
            >;
        };

        func {
            display-name = "ADJ";
            bindings = <
                &mo TAB   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &kp BSPC
                &kp LCTRL &trans &kp F4 &kp F5 &kp F6 &kp F11   &trans       &trans      &trans       &trans &trans &trans
                &bt LSHFT &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans &trans &trans
                                   &kp LGUI &mo NAV &kp SPACE   &kp RET &mo 2 &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
